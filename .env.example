# Firebase web app (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin service account (server only; never NEXT_PUBLIC_*)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional canonical site origin for CSRF verification; full URL is recommended.
# Browser requests from the same host are also accepted, including other Vercel aliases.
# Example: https://hmrshs.vercel.app (bare hostname is supported).
APP_ORIGIN=http://localhost:3000

# ImgBB API key (server only; used for principal's homepage photo uploads)
IMGBB_API_KEY=
