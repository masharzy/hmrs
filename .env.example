# Firebase web app (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin service account (server only; never NEXT_PUBLIC_*)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# UID of an existing Firebase Auth user designated to bootstrap head-teacher access
HEAD_TEACHER_UID=

# Optional: set to canonical deployed site for CSRF Origin verification
APP_ORIGIN=http://localhost:3000
